<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Medicine Guide - JeevBandhu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-surface-light min-h-screen font-sans">
    <!-- Navigation -->
    <nav class="nav-glass sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <a href="/dashboard" class="flex items-center gap-2 text-xl font-extrabold gradient-text">
                    <span class="text-2xl">🐄</span> JeevBandhu
                </a>
                <div class="hidden lg:flex items-center gap-6">
                    <a href="/dashboard" class="nav-link">Dashboard</a>
                    <div class="relative group">
                        <button class="nav-link inline-flex items-center gap-1">Farm
                            <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                        </button>
                        <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                            <div class="w-56 bg-white rounded-2xl shadow-xl border border-emerald-100 py-2 overflow-hidden">
                                <a href="/animals/add" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">➕ Add Animal</a>
                                <a href="/dashboard" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">📊 My Animals</a>
                                <a href="/ai-assistant" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">🩺 AI Diagnosis</a>
                                <a href="/guide/medicine-guide" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">💊 Medicine Guide</a>
                                <a href="/compliance" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">✅ Biosecurity</a>
                            </div>
                        </div>
                    </div>
                    <div class="relative group">
                        <button class="nav-link inline-flex items-center gap-1">Commerce
                            <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                        </button>
                        <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                            <div class="w-56 bg-white rounded-2xl shadow-xl border border-emerald-100 py-2 overflow-hidden">
                                <a href="/marketplace" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">🛒 Browse Marketplace</a>
                                <a href="/list-product" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">➕ List Product</a>
                                <a href="/my-products" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">📦 My Products</a>
                                <a href="/orders/sales" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">💰 Sales</a>
                            </div>
                        </div>
                    </div>
                    <a href="/community" class="nav-link">Community</a>
                    <span class="px-3 py-1.5 bg-emerald-50 text-emerald-800 rounded-full text-sm font-semibold">Hi, <%= user.name %></span>
                    <form action="/logout" method="POST" class="inline">
                        <button type="submit" class="text-red-600 hover:text-red-700 font-medium transition">Logout</button>
                    </form>
                </div>
                <!-- Mobile hamburger -->
                <button id="medicineMenuBtn" class="lg:hidden flex flex-col justify-center items-center w-10 h-10 hamburger z-50 relative" aria-label="Menu">
                    <span class="block w-6 h-0.5 bg-gray-700 mb-1"></span>
                    <span class="block w-6 h-0.5 bg-gray-700 mb-1"></span>
                    <span class="block w-6 h-0.5 bg-gray-700"></span>
                </button>
            </div>
        </div>
        <!-- Mobile Menu Overlay -->
        <div id="medicineMenu" class="mobile-menu hidden fixed top-0 right-0 h-full w-72 bg-white shadow-2xl z-40 lg:hidden overflow-y-auto">
            <div class="flex flex-col p-6 pt-20 space-y-1">
                <a href="/dashboard" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">🏠 Dashboard</a>
                <a href="/animals/add" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">➕ Add Animal</a>
                <a href="/ai-assistant" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">🩺 AI Diagnosis</a>
                <a href="/guide/medicine-guide" class="text-emerald-700 font-semibold py-2.5 border-b border-gray-100">💊 Medicine Guide</a>
                <a href="/compliance" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">✅ Biosecurity</a>
                <a href="/marketplace" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">🛒 Marketplace</a>
                <a href="/list-product" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">📦 List Product</a>
                <a href="/my-products" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">📦 My Products</a>
                <a href="/orders/sales" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">💰 Sales</a>
                <a href="/community" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">👥 Community</a>
                <span class="text-emerald-800 font-semibold px-3 py-2 bg-emerald-50 rounded-full text-center mt-2">Hi, <%= user.name %></span>
                <form action="/logout" method="POST" class="inline">
                    <button type="submit" class="w-full text-left text-red-600 hover:text-red-700 font-medium py-2.5">Logout</button>
                </form>
            </div>
        </div>
    </nav>

    <!-- Page Hero -->
    <header class="bg-gradient-to-br from-emerald-50 via-emerald-100/60 to-teal-50 border-b border-emerald-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-brand-gradient shadow-glow-emerald mb-5 animate-float">
                <!-- Pill / capsule icon -->
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3.2" y="8.8" width="17.6" height="6.4" rx="3.2" transform="rotate(-45 12 12)" stroke-linecap="round"/>
                    <path stroke-linecap="round" d="M8.5 8.5l7 7"/>
                </svg>
            </div>
            <h1 class="font-extrabold text-emerald-950 tracking-tight" style="font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.1;">
                Medicine Guide
            </h1>
            <p class="text-emerald-800/80 mt-4 max-w-2xl mx-auto text-base md:text-lg">
                Research-based dosages, treatment guidelines, and mandatory withdrawal periods —
                so every product you sell stays bio-safe for consumers.
            </p>
        </div>
    </header>

    <!-- Sticky Search Bar -->
    <div class="sticky top-16 z-40 bg-surface-light/90 backdrop-blur border-b border-emerald-100/60 py-4">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center gap-3">
                <div class="relative flex-1">
                    <svg class="w-5 h-5 text-emerald-600 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="7"/>
                        <path stroke-linecap="round" d="M21 21l-4.35-4.35"/>
                    </svg>
                    <input type="text" id="medicineSearch"
                        placeholder="Search by treatment or medicine name (e.g., mastitis, pneumonia, worms...)"
                        class="input-field w-full !rounded-full pl-12 pr-4 py-3 shadow-sm">
                </div>
                <div class="hidden sm:flex items-center px-4 py-2.5 bg-emerald-50 border border-emerald-100 rounded-full whitespace-nowrap">
                    <span class="text-sm text-emerald-700 font-semibold">
                        <span id="visibleMedicines">
                            <%= medicines.length %>
                        </span> of <%= medicines.length %> shown
                    </span>
                </div>
            </div>
        </div>
    </div>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Species Filter Chips -->
        <div class="mb-8 reveal">
            <p class="label-caps text-emerald-700 mb-3 text-center">Select Animal Species</p>
            <div class="flex flex-wrap justify-center gap-3">
                <a href="/guide/medicine-guide?species=cattle"
                    class="<%= species === 'cattle' ? 'bg-emerald-600 text-white border-emerald-600 shadow-glow-emerald' : 'bg-white text-gray-700 border-emerald-200 hover:bg-emerald-50 hover:border-emerald-400' %> inline-flex items-center gap-2 px-5 py-2.5 rounded-full border-2 font-semibold text-sm transition cursor-pointer">
                    <span class="text-lg">🐄</span> Cattle
                </a>
                <a href="/guide/medicine-guide?species=buffalo"
                    class="<%= species === 'buffalo' ? 'bg-emerald-600 text-white border-emerald-600 shadow-glow-emerald' : 'bg-white text-gray-700 border-emerald-200 hover:bg-emerald-50 hover:border-emerald-400' %> inline-flex items-center gap-2 px-5 py-2.5 rounded-full border-2 font-semibold text-sm transition cursor-pointer">
                    <span class="text-lg">🐃</span> Buffalo
                </a>
                <a href="/guide/medicine-guide?species=goat"
                    class="<%= species === 'goat' ? 'bg-emerald-600 text-white border-emerald-600 shadow-glow-emerald' : 'bg-white text-gray-700 border-emerald-200 hover:bg-emerald-50 hover:border-emerald-400' %> inline-flex items-center gap-2 px-5 py-2.5 rounded-full border-2 font-semibold text-sm transition cursor-pointer">
                    <span class="text-lg">🐐</span> Goat
                </a>
                <a href="/guide/medicine-guide?species=sheep"
                    class="<%= species === 'sheep' ? 'bg-emerald-600 text-white border-emerald-600 shadow-glow-emerald' : 'bg-white text-gray-700 border-emerald-200 hover:bg-emerald-50 hover:border-emerald-400' %> inline-flex items-center gap-2 px-5 py-2.5 rounded-full border-2 font-semibold text-sm transition cursor-pointer">
                    <span class="text-lg">🐑</span> Sheep
                </a>
                <a href="/guide/medicine-guide?species=poultry"
                    class="<%= species === 'poultry' ? 'bg-emerald-600 text-white border-emerald-600 shadow-glow-emerald' : 'bg-white text-gray-700 border-emerald-200 hover:bg-emerald-50 hover:border-emerald-400' %> inline-flex items-center gap-2 px-5 py-2.5 rounded-full border-2 font-semibold text-sm transition cursor-pointer">
                    <span class="text-lg">🐔</span> Poultry
                </a>
            </div>
        </div>

        <!-- Medicine Cards -->
        <% if (medicines.length===0) { %>
            <div class="card-premium text-center py-16 reveal">
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-emerald-50 mb-5">
                    <svg class="w-10 h-10 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="3.2" y="8.8" width="17.6" height="6.4" rx="3.2" transform="rotate(-45 12 12)" stroke-linecap="round"/>
                        <path stroke-linecap="round" d="M8.5 8.5l7 7"/>
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-gray-700 mb-2">No medicines found</h2>
                <p class="text-gray-500">Try a different search term</p>
            </div>
            <% } else { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="medicineGrid">
                    <% medicines.forEach(medicine=> { %>
                        <div class="card-premium medicine-card reveal"
                            data-name="<%= medicine.name.toLowerCase() %>"
                            data-treatments="<%= medicine.treatments.map(t => t.toLowerCase()).join(',') %>"
                            data-category="<%= medicine.category.toLowerCase() %>">
                            <!-- Header -->
                            <div class="flex justify-between items-start gap-3 mb-4">
                                <div>
                                    <h3 class="text-xl font-extrabold text-gray-900 leading-tight">
                                        <%= medicine.name %>
                                    </h3>
                                    <span class="inline-block mt-1.5 px-2.5 py-0.5 bg-emerald-50 text-emerald-700 border border-emerald-100 text-xs font-semibold rounded-full">
                                        <%= medicine.category %>
                                    </span>
                                </div>
                                <span class="badge whitespace-nowrap
                                <%= medicine.type === 'Antibiotic' ? 'bg-red-100 text-red-800' : '' %>
                                <%= medicine.type === 'Anti-parasitic' ? 'bg-purple-100 text-purple-800' : '' %>
                                <%= medicine.type === 'NSAID' ? 'bg-blue-100 text-blue-800' : '' %>
                                <%= medicine.type === 'Vitamin Supplement' ? 'bg-green-100 text-green-800' : '' %>
                                <%= medicine.type === 'Mineral Supplement' ? 'bg-yellow-100 text-yellow-800' : '' %>
                                <%= medicine.type === 'Anti-protozoal' ? 'bg-pink-100 text-pink-800' : '' %>
                            ">
                                    <%= medicine.type %>
                                </span>
                            </div>

                            <!-- WITHDRAWAL PERIOD — visual hero -->
                            <div class="rounded-2xl border border-red-200 bg-gradient-to-r from-red-50 to-amber-50 p-4 mb-4">
                                <div class="flex items-center gap-2 mb-3">
                                    <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <circle cx="12" cy="12" r="9"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 3"/>
                                    </svg>
                                    <p class="label-caps text-red-700">Withdrawal Period</p>
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div class="text-center rounded-xl bg-white/70 border border-red-100 p-3">
                                        <p class="text-3xl font-extrabold text-red-600 leading-none">
                                            <%= medicine.withdrawalPeriod.meat %>
                                        </p>
                                        <p class="text-[11px] font-semibold uppercase tracking-wide text-red-700 mt-1.5">days · 🥩 Meat</p>
                                    </div>
                                    <div class="text-center rounded-xl bg-white/70 border border-amber-100 p-3">
                                        <p class="text-3xl font-extrabold text-amber-600 leading-none">
                                            <%= medicine.withdrawalPeriod.milk !==undefined ? medicine.withdrawalPeriod.milk
                                                + ' days' : medicine.withdrawalPeriod.eggs !==undefined ?
                                                medicine.withdrawalPeriod.eggs + ' days' : 'N/A' %>
                                        </p>
                                        <p class="text-[11px] font-semibold uppercase tracking-wide text-amber-700 mt-1.5">
                                            <%= species==='poultry' ? '🥚 Egg Withdrawal' : '🥛 Milk Withdrawal' %>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Treatments -->
                            <div class="mb-4">
                                <p class="label-caps text-gray-500 mb-2">Treats</p>
                                <div class="flex flex-wrap gap-2">
                                    <% medicine.treatments.forEach(treatment=> { %>
                                        <span class="px-3 py-1 bg-emerald-50 text-emerald-700 text-sm rounded-full">
                                            <%= treatment %>
                                        </span>
                                        <% }) %>
                                </div>
                            </div>

                            <!-- Dosage Calculator -->
                            <div class="rounded-2xl border border-emerald-100 bg-emerald-50/50 p-4 mb-4">
                                <div class="flex items-center gap-2 mb-3">
                                    <svg class="w-4 h-4 text-emerald-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 3h6M10 3v4.3L4.9 16.5A3 3 0 007.6 21h8.8a3 3 0 002.7-4.5L14 7.3V3"/>
                                        <path stroke-linecap="round" d="M7 15h10"/>
                                    </svg>
                                    <h4 class="font-bold text-gray-900 text-sm">Dosage Calculator</h4>
                                </div>
                                <div class="space-y-2">
                                    <div class="flex items-center gap-2">
                                        <label class="text-sm text-gray-700 whitespace-nowrap">Animal Weight:</label>
                                        <input type="number" id="weight-<%= medicine.id %>" min="1" step="1"
                                            placeholder="kg" class="input-field flex-1 min-w-0 px-3 py-2">
                                        <button onclick="calculateDosage('<%= species %>', '<%= medicine.id %>')"
                                            class="btn-primary px-4 py-2 whitespace-nowrap">
                                            Calculate
                                        </button>
                                    </div>
                                    <div id="result-<%= medicine.id %>"
                                        class="hidden mt-3 p-3 bg-white border border-emerald-200 rounded-xl">
                                        <p class="text-sm font-semibold text-gray-900 mb-1">Recommended Dosage:</p>
                                        <p id="dosage-<%= medicine.id %>" class="text-emerald-600 font-bold"></p>
                                    </div>
                                </div>
                                <dl class="mt-3 text-xs text-gray-700 divide-y divide-emerald-100">
                                    <div class="flex justify-between gap-4 py-1.5">
                                        <dt class="font-semibold text-gray-500 uppercase tracking-wide">Standard Dosage</dt>
                                        <dd class="text-right font-medium">
                                            <%= medicine.dosage.amount %>
                                                <%= medicine.dosage.unit %>
                                        </dd>
                                    </div>
                                    <div class="flex justify-between gap-4 py-1.5">
                                        <dt class="font-semibold text-gray-500 uppercase tracking-wide">Route</dt>
                                        <dd class="text-right font-medium">
                                            <%= medicine.dosage.route %>
                                        </dd>
                                    </div>
                                    <div class="flex justify-between gap-4 py-1.5">
                                        <dt class="font-semibold text-gray-500 uppercase tracking-wide">Frequency</dt>
                                        <dd class="text-right font-medium">
                                            <%= medicine.dosage.frequency %>
                                        </dd>
                                    </div>
                                </dl>
                            </div>

                            <!-- Precautions & Side Effects -->
                            <div class="space-y-2 text-sm">
                                <div class="bg-amber-50 border-l-4 border-amber-500 p-3 rounded-r-xl">
                                    <span class="badge-warning mb-1.5">⚠️ Precautions</span>
                                    <p class="text-amber-900 mt-1.5">
                                        <%= medicine.precautions %>
                                    </p>
                                </div>
                                <% if (medicine.sideEffects) { %>
                                    <div class="bg-orange-50 border-l-4 border-orange-500 p-3 rounded-r-xl">
                                        <p class="font-semibold text-orange-900 mb-1">Side Effects:</p>
                                        <p class="text-orange-800">
                                            <%= medicine.sideEffects %>
                                        </p>
                                    </div>
                                    <% } %>
                                        <% if (medicine.contraindications) { %>
                                            <div class="bg-red-50 border-l-4 border-red-500 p-3 rounded-r-xl">
                                                <p class="font-semibold text-red-900 mb-1">🚫 Contraindications:</p>
                                                <p class="text-red-800">
                                                    <%= medicine.contraindications %>
                                                </p>
                                            </div>
                                            <% } %>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } %>

                    <!-- Info Section -->
                    <div class="mt-10 card-premium bg-gradient-to-r from-emerald-50 to-teal-50 reveal">
                        <h3 class="section-title text-lg mb-4">Important Information</h3>
                        <ul class="space-y-2.5 text-sm text-gray-700">
                            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Always consult a licensed veterinarian before administering medications</li>
                            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Complete the full course of antibiotics even if symptoms improve</li>
                            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Withdrawal periods are MANDATORY for food safety - do not list products during this time</li>
                            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Store all medications as per manufacturer's instructions</li>
                            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Keep detailed records of all treatments in the medical log</li>
                            <li class="flex items-start gap-2"><svg class="w-4 h-4 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Calculate dosages based on current animal weight for accuracy</li>
                        </ul>
                    </div>
    </main>

    <footer class="bg-slate-950 mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 md:grid-cols-4 gap-8">
            <div>
                <p class="text-xl font-extrabold text-white">🐄 JeevBandhu</p>
                <p class="text-slate-400 text-sm mt-3">Bio-safe livestock health management for Indian farmers. Smart forecasting for healthy livestock. 🌱</p>
            </div>
            <div>
                <p class="label-caps text-emerald-400 mb-3">Platform</p>
                <ul class="space-y-2 text-sm text-slate-300">
                    <li><a href="/dashboard" class="hover:text-emerald-400 transition">Dashboard</a></li>
                    <li><a href="/marketplace" class="hover:text-emerald-400 transition">Marketplace</a></li>
                    <li><a href="/community" class="hover:text-emerald-400 transition">Community</a></li>
                </ul>
            </div>
            <div>
                <p class="label-caps text-emerald-400 mb-3">Resources</p>
                <ul class="space-y-2 text-sm text-slate-300">
                    <li><a href="/guide/medicine-guide" class="hover:text-emerald-400 transition">Medicine Guide</a></li>
                    <li><a href="/ai-assistant" class="hover:text-emerald-400 transition">AI Assistant</a></li>
                    <li><a href="/compliance" class="hover:text-emerald-400 transition">Biosecurity</a></li>
                </ul>
            </div>
            <div>
                <p class="label-caps text-emerald-400 mb-3">Trust</p>
                <p class="text-sm text-slate-300">Every product verified bio-safe with full withdrawal-period compliance.</p>
            </div>
        </div>
        <div class="border-t border-white/10">
            <p class="text-center text-slate-500 text-sm py-5">© 2024 JeevBandhu — Ensuring Bio-Safe Livestock Products</p>
        </div>
    </footer>

    <script>
        // Mobile menu toggle for medicine guide
        const medicineMenuBtn = document.getElementById('medicineMenuBtn');
        const medicineMenu = document.getElementById('medicineMenu');

        if (medicineMenuBtn && medicineMenu) {
            medicineMenuBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                medicineMenu.classList.toggle('hidden');
                medicineMenu.classList.toggle('active');
                medicineMenuBtn.classList.toggle('active');
            });

            // Close menu when clicking outside
            document.addEventListener('click', function (e) {
                if (medicineMenu && !medicineMenu.contains(e.target) && !medicineMenuBtn.contains(e.target)) {
                    medicineMenu.classList.add('hidden');
                    medicineMenu.classList.remove('active');
                    medicineMenuBtn.classList.remove('active');
                }
            });

            // Close menu when clicking a link
            const medicineLinks = medicineMenu.querySelectorAll('a');
            medicineLinks.forEach(link => {
                link.addEventListener('click', function () {
                    medicineMenu.classList.add('hidden');
                    medicineMenu.classList.remove('active');
                    medicineMenuBtn.classList.remove('active');
                });
            });
        }

        // Dosage calculation function
        async function calculateDosage(species, medicineId) {
            const weightInput = document.getElementById(`weight-${medicineId}`);
            const resultDiv = document.getElementById(`result-${medicineId}`);
            const dosageText = document.getElementById(`dosage-${medicineId}`);

            const weight = parseFloat(weightInput.value);

            if (!weight || weight <= 0) {
                alert('⚠️ Please enter a valid animal weight');
                return;
            }

            try {
                const response = await fetch('/guide/medicine/calculate-dosage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ species, medicineId, weight })
                });

                const result = await response.json();

                if (result.success) {
                    const info = result.dosageInfo;
                    dosageText.innerHTML = `
                        <strong>${info.dosage}</strong><br>
                        <span class="text-sm text-gray-700">${info.route}</span><br>
                        <span class="text-sm text-gray-700">${info.frequency}</span>
                    `;
                    resultDiv.classList.remove('hidden');
                } else {
                    alert(`❌ ${result.error}`);
                }
            } catch (error) {
                alert('❌ Failed to calculate dosage. Please try again.');
            }
        }

        // Real-time search functionality
        const searchInput = document.getElementById('medicineSearch');
        const medicineCards = document.querySelectorAll('.medicine-card');
        const visibleCount = document.getElementById('visibleMedicines');

        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const searchTerm = this.value.toLowerCase().trim();
                let visible = 0;

                medicineCards.forEach(card => {
                    const name = card.dataset.name;
                    const treatments = card.dataset.treatments;
                    const category = card.dataset.category;

                    // Check if search term matches name, treatments, or category
                    const matches = name.includes(searchTerm) ||
                        treatments.includes(searchTerm) ||
                        category.includes(searchTerm);

                    if (matches || searchTerm === '') {
                        card.style.display = 'block';
                        visible++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                // Update visible count
                if (visibleCount) {
                    visibleCount.textContent = visible;
                }
            });
        }

        // Scroll-reveal animations
        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); revealObserver.unobserve(e.target); } });
        }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
    </script>
</body>

</html>