<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - JeevBandhu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-surface-light min-h-screen font-sans">
    <div class="min-h-screen flex">

        <!-- Left brand panel (desktop only) -->
        <div class="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-gradient-to-br from-emerald-950 via-emerald-800 to-emerald-600 flex-col justify-between p-12">
            <!-- Abstract CSS art -->
            <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
                <div class="absolute -top-24 -right-24 w-96 h-96 bg-emerald-400/30 rounded-full blur-3xl animate-float-slow"></div>
                <div class="absolute bottom-16 -left-20 w-80 h-80 bg-gold-400/20 rounded-full blur-3xl animate-float-slow" style="animation-delay: 2s;"></div>
                <div class="absolute top-1/2 left-1/3 w-52 h-52 bg-emerald-300/20 rounded-full blur-2xl animate-float-slow" style="animation-delay: 4s;"></div>
                <span class="particle" style="left: 10%; width: 7px; height: 7px; animation-duration: 15s; animation-delay: 1s;"></span>
                <span class="particle" style="left: 26%; width: 5px; height: 5px; animation-duration: 19s; animation-delay: 4s;"></span>
                <span class="particle" style="left: 48%; width: 9px; height: 9px; animation-duration: 14s; animation-delay: 0s;"></span>
                <span class="particle" style="left: 70%; width: 6px; height: 6px; animation-duration: 21s; animation-delay: 6s;"></span>
                <span class="particle" style="left: 90%; width: 8px; height: 8px; animation-duration: 17s; animation-delay: 3s;"></span>
            </div>

            <!-- Brand logo -->
            <a href="/" class="relative z-10 flex items-center gap-2 text-2xl font-extrabold text-white">
                <span class="text-3xl">🐄</span> JeevBandhu
            </a>

            <!-- Tagline + bullets -->
            <div class="relative z-10 max-w-lg">
                <h1 class="text-4xl xl:text-5xl font-extrabold text-white leading-tight">
                    Protect your herd.<br>
                    <span class="text-gold-400">Prove your quality.</span>
                </h1>
                <p class="mt-4 text-emerald-100 text-lg">Join a community of farmers and buyers built on verified bio-safety.</p>
                <ul class="mt-8 space-y-4 text-white">
                    <li class="flex items-center gap-3">
                        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-white/15 flex items-center justify-center">
                            <svg class="w-4 h-4 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        </span>
                        <span class="font-medium">Free AI health assistant for every farmer</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-white/15 flex items-center justify-center">
                            <svg class="w-4 h-4 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        </span>
                        <span class="font-medium">Buyers get certified bio-safe products only</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-white/15 flex items-center justify-center">
                            <svg class="w-4 h-4 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        </span>
                        <span class="font-medium">Track medicines, withdrawal periods & compliance</span>
                    </li>
                </ul>
            </div>

            <p class="relative z-10 text-emerald-200/70 text-sm">© 2024 JeevBandhu — Ensuring Bio-Safe Livestock Products</p>
        </div>

        <!-- Right form panel -->
        <div class="w-full lg:w-1/2 bg-gradient-to-b from-white to-green-50 flex flex-col">
            <div class="p-6 sm:p-8">
                <a href="/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-700 hover:text-emerald-800 transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                    JeevBandhu
                </a>
            </div>

            <div class="flex-1 flex items-center justify-center px-4 sm:px-6 lg:px-8 pb-12">
                <div class="max-w-md w-full animate-fade-in">
                    <div class="text-center">
                        <span class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-brand-gradient text-3xl shadow-glow-emerald">🐄</span>
                        <h2 class="mt-5 text-3xl font-extrabold text-gray-900">Create your account</h2>
                        <p class="mt-2 text-sm text-gray-600">
                            Join JeevBandhu today
                        </p>
                    </div>

                    <form class="mt-8 space-y-6" action="/register" method="POST">
                        <div class="card shadow-xl rounded-2xl">
                            <% if (error) { %>
                                <div class="mb-5 flex items-start gap-3 p-4 bg-red-50 border border-red-200 text-red-700 rounded-xl animate-slide-up" role="alert">
                                    <svg class="w-5 h-5 flex-shrink-0 mt-0.5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                                    <span class="text-sm font-medium"><%= error %></span>
                                </div>
                                <% } %>

                                    <div class="space-y-5">
                                        <div>
                                            <label for="name" class="block text-sm font-semibold text-gray-700 mb-1.5">Full Name</label>
                                            <input id="name" name="name" type="text" required class="input-field"
                                                placeholder="John Doe">
                                        </div>

                                        <div>
                                            <label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5">Email Address</label>
                                            <input id="email" name="email" type="email" required class="input-field"
                                                placeholder="john@example.com">
                                        </div>

                                        <div>
                                            <label for="password" class="block text-sm font-semibold text-gray-700 mb-1.5">Password</label>
                                            <input id="password" name="password" type="password" required class="input-field"
                                                placeholder="At least 6 characters">
                                        </div>

                                        <div>
                                            <label for="confirmPassword" class="block text-sm font-semibold text-gray-700 mb-1.5">Confirm Password</label>
                                            <input id="confirmPassword" name="confirmPassword" type="password" required
                                                class="input-field" placeholder="Confirm your password">
                                        </div>

                                        <div>
                                            <span class="block text-sm font-semibold text-gray-700 mb-2">I am a:</span>
                                            <div class="grid grid-cols-2 gap-3">
                                                <label class="cursor-pointer">
                                                    <input type="radio" name="role" value="farmer" required class="peer sr-only">
                                                    <div class="rounded-xl border-2 border-gray-200 bg-white p-4 text-center transition-all duration-200 hover:border-emerald-300 peer-checked:border-emerald-600 peer-checked:bg-emerald-50 peer-checked:shadow-glow-emerald">
                                                        <span class="block text-3xl mb-1">🌾</span>
                                                        <span class="block font-bold text-gray-900">Farmer</span>
                                                        <span class="block text-xs text-gray-500 mt-0.5">Manage &amp; sell livestock products</span>
                                                    </div>
                                                </label>
                                                <label class="cursor-pointer">
                                                    <input type="radio" name="role" value="buyer" required class="peer sr-only">
                                                    <div class="rounded-xl border-2 border-gray-200 bg-white p-4 text-center transition-all duration-200 hover:border-emerald-300 peer-checked:border-emerald-600 peer-checked:bg-emerald-50 peer-checked:shadow-glow-emerald">
                                                        <span class="block text-3xl mb-1">🛒</span>
                                                        <span class="block font-bold text-gray-900">Buyer</span>
                                                        <span class="block text-xs text-gray-500 mt-0.5">Shop verified bio-safe products</span>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-6">
                                        <button type="submit" class="w-full btn-primary">
                                            Create Account
                                        </button>
                                    </div>

                                    <div class="mt-5 text-center">
                                        <p class="text-sm text-gray-600">
                                            Already have an account?
                                            <a href="/login" class="font-semibold text-emerald-600 hover:text-emerald-500">Sign in</a>
                                        </p>
                                    </div>
                        </div>
                    </form>

                    <p class="mt-6 flex items-center justify-center gap-2 text-sm text-gray-500">
                        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6 0a4 4 0 10-1.33-7.77"/></svg>
                        Join 1,200+ farmers protecting their livestock
                    </p>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
