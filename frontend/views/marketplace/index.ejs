<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Marketplace - JeevBandhu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-surface-light min-h-screen font-sans">
    <!-- Navigation -->
    <nav class="nav-glass sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <a href="/marketplace" class="flex items-center gap-2 text-xl font-extrabold gradient-text">
                    <span class="text-2xl">🐄</span> JeevBandhu
                </a>
                <div class="hidden lg:flex items-center gap-6">
                    <a href="/marketplace" class="nav-link active">Marketplace</a>
                    <% if (user.role==='buyer' ) { %>
                        <a href="/orders/my-orders" class="nav-link">My Orders</a>
                        <% } %>
                    <% if (user.role==='farmer' ) { %>
                        <a href="/dashboard" class="nav-link">Dashboard</a>
                        <div class="relative group">
                            <button class="nav-link inline-flex items-center gap-1">Farm
                                <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                            </button>
                            <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                                <div class="w-56 bg-white rounded-2xl shadow-xl border border-emerald-100 py-2 overflow-hidden">
                                    <a href="/animals/add" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">➕ Add Animal</a>
                                    <a href="/dashboard" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">📊 My Animals</a>
                                    <a href="/ai-assistant" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">🩺 AI Diagnosis</a>
                                    <a href="/guide/medicine-guide" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">💊 Medicine Guide</a>
                                    <a href="/compliance" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">✅ Biosecurity</a>
                                </div>
                            </div>
                        </div>
                        <div class="relative group">
                            <button class="nav-link inline-flex items-center gap-1">Commerce
                                <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                            </button>
                            <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                                <div class="w-56 bg-white rounded-2xl shadow-xl border border-emerald-100 py-2 overflow-hidden">
                                    <a href="/marketplace" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">🛒 Browse Marketplace</a>
                                    <a href="/list-product" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">➕ List Product</a>
                                    <a href="/my-products" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">📦 My Products</a>
                                    <a href="/orders/sales" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-700">💰 Sales</a>
                                </div>
                            </div>
                        </div>
                        <a href="/community" class="nav-link">Community</a>
                        <% } %>
                    <span class="px-3 py-1.5 bg-emerald-50 text-emerald-800 rounded-full text-sm font-semibold">Hi, <%= user.name %></span>
                    <form action="/logout" method="POST" class="inline">
                        <button type="submit" class="text-red-600 hover:text-red-700 font-medium transition">Logout</button>
                    </form>
                </div>
                <!-- Mobile hamburger -->
                <button id="mobileMenuBtn" class="lg:hidden flex flex-col justify-center items-center w-10 h-10 hamburger z-50 relative" aria-label="Menu">
                    <span class="block w-6 h-0.5 bg-gray-700 mb-1"></span>
                    <span class="block w-6 h-0.5 bg-gray-700 mb-1"></span>
                    <span class="block w-6 h-0.5 bg-gray-700"></span>
                </button>
            </div>
        </div>
        <div id="mobileMenu" class="mobile-menu hidden fixed top-0 right-0 h-full w-72 bg-white shadow-2xl z-40 lg:hidden overflow-y-auto">
            <div class="flex flex-col p-6 pt-20 space-y-1">
                <a href="/marketplace" class="text-emerald-700 font-semibold py-2.5 border-b border-gray-100">🛒 Marketplace</a>
                <% if (user.role==='buyer' ) { %>
                    <a href="/orders/my-orders" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">📦 My Orders</a>
                    <% } %>
                <% if (user.role==='farmer' ) { %>
                    <a href="/dashboard" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">🏠 Dashboard</a>
                    <a href="/animals/add" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">➕ Add Animal</a>
                    <a href="/ai-assistant" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">🩺 AI Diagnosis</a>
                    <a href="/guide/medicine-guide" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">💊 Medicine Guide</a>
                    <a href="/compliance" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">✅ Biosecurity</a>
                    <a href="/list-product" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">📦 List Product</a>
                    <a href="/my-products" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">📦 My Products</a>
                    <a href="/orders/sales" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">💰 Sales</a>
                    <a href="/community" class="text-gray-700 hover:text-emerald-600 font-medium py-2.5 border-b border-gray-100">👥 Community</a>
                    <% } %>
                <span class="text-emerald-800 font-semibold px-3 py-2 bg-emerald-50 rounded-full text-center mt-2">Hi, <%= user.name %></span>
                <form action="/logout" method="POST"><button type="submit" class="w-full text-left text-red-600 hover:text-red-700 font-medium py-2.5">Logout</button></form>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Hero Banner -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-emerald-800 via-emerald-700 to-emerald-600 p-8 md:p-10 mb-8 text-white shadow-glow-emerald animate-fade-in">
            <div class="absolute -right-8 -bottom-10 opacity-10 pointer-events-none">
                <svg class="w-56 h-56" fill="currentColor" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
            </div>
            <div class="relative flex flex-col md:flex-row md:items-center gap-6">
                <div class="flex-shrink-0 w-16 h-16 rounded-2xl bg-white/15 backdrop-blur flex items-center justify-center">
                    <svg class="w-9 h-9 text-emerald-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="display-title text-white mb-2">Verified Bio-Safe Products Only</h1>
                    <p class="text-emerald-100 max-w-2xl">All products are verified antibiotic-free with complete medical transparency and full withdrawal-period compliance.</p>
                    <div class="mt-4"><span class="badge-biosafe">✓ Bio-Safe Certified Marketplace</span></div>
                </div>
            </div>
        </div>

        <div class="flex flex-col lg:flex-row gap-8 items-start">
            <!-- Filter Sidebar -->
            <aside class="w-full lg:w-64 lg:flex-shrink-0 lg:sticky lg:top-24">
                <button id="filterToggleBtn" class="lg:hidden w-full flex items-center justify-between px-5 py-3 mb-3 bg-white rounded-2xl shadow-sm border border-emerald-100 font-semibold text-gray-800" aria-expanded="false">
                    <span class="inline-flex items-center gap-2">
                        <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
                        Search &amp; Filters
                    </span>
                    <svg id="filterToggleChevron" class="w-4 h-4 text-gray-500 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div id="filterPanel" class="hidden lg:block card-premium">
                    <h2 class="hidden lg:flex items-center gap-2 text-lg font-bold text-gray-900 mb-5">
                        <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
                        Search &amp; Filters
                    </h2>

                    <div class="space-y-5">
                        <!-- Search Bar -->
                        <div>
                            <label class="label-caps text-gray-500 block mb-2">Search</label>
                            <input type="text" id="searchInput" placeholder="Search by product type..."
                                class="input-field w-full">
                        </div>

                        <!-- Price Range -->
                        <div>
                            <label class="label-caps text-gray-500 block mb-2">Max Price (₹)</label>
                            <input type="number" id="priceFilter" placeholder="Max price..."
                                class="input-field w-full">
                        </div>

                        <!-- Min Quantity Available -->
                        <div>
                            <label class="label-caps text-gray-500 block mb-2">Min Available Quantity</label>
                            <input type="number" id="quantityFilter" placeholder="Min quantity..."
                                class="input-field w-full">
                        </div>

                        <!-- Clear Filters Button -->
                        <button onclick="clearFilters()" class="btn-secondary w-full">
                            Clear Filters
                        </button>
                    </div>
                </div>
            </aside>

            <!-- Products -->
            <section class="flex-1 w-full min-w-0">
                <% if (products.length===0) { %>
                    <div class="card-premium text-center py-16 reveal">
                        <div class="mx-auto mb-6 w-20 h-20 rounded-3xl bg-emerald-50 flex items-center justify-center">
                            <svg class="w-10 h-10 text-emerald-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                        </div>
                        <h2 class="text-2xl font-bold text-gray-900 mb-2">No products available yet</h2>
                        <p class="text-gray-600">Check back soon for verified livestock products</p>
                    </div>
                    <% } else { %>
                        <div class="mb-6 flex items-center justify-between" id="productCount">
                            <p class="text-gray-600">Showing <span id="visibleCount" class="font-bold text-emerald-700">
                                    <%= products.length %>
                                </span> of <%= products.length %> verified product<%= products.length !==1 ? 's' : '' %>
                            </p>
                        </div>

                        <!-- Product Grid -->
                        <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">
                            <% products.forEach(product=> { %>
                                <% // Backwards compatibility: handle old products without quantity fields const
                                    hasQuantitySystem=product.pricePerUnit !==undefined && product.totalQuantity !==undefined;
                                    const availableQty=hasQuantitySystem ? (product.totalQuantity - (product.quantitySold || 0))
                                    : (product.quantity || 0); %>
                                <% const _pt = product.productType.toLowerCase();
                                   const _emoji = _pt.includes('milk') ? '🥛' : _pt.includes('egg') ? '🥚' : _pt.includes('honey') ? '🍯' : _pt.includes('wool') ? '🧶' : _pt.includes('meat') || _pt.includes('chicken') || _pt.includes('mutton') ? '🍖' : _pt.includes('ghee') || _pt.includes('butter') ? '🧈' : _pt.includes('cheese') || _pt.includes('paneer') ? '🧀' : _pt.includes('curd') || _pt.includes('yogurt') || _pt.includes('dahi') ? '🥣' : '🌾'; %>
                                    <div class="card-premium product-card reveal group hover:-translate-y-1 hover:shadow-glow-emerald transition-all duration-300"
                                        data-product-type="<%= product.productType.toLowerCase() %>"
                                        data-price="<%= product.pricePerUnit || product.price || 0 %>"
                                        data-quantity="<%= availableQty %>">
                                        <!-- Gradient image placeholder -->
                                        <div class="relative h-28 -mx-6 -mt-6 mb-5 rounded-t-2xl overflow-hidden bg-gradient-to-br from-emerald-700 via-emerald-800 to-slate-900">
                                            <span class="absolute -right-2 -bottom-4 text-7xl opacity-25 select-none group-hover:scale-110 transition-transform duration-500"><%= _emoji %></span>
                                            <span class="absolute left-4 top-4 badge-biosafe">✓ Bio-Safe Verified</span>
                                        </div>

                                        <div class="flex justify-between items-start mb-4">
                                            <h3 class="text-2xl font-bold text-gray-900">
                                                <%= product.productType %>
                                            </h3>
                                            <span class="text-3xl" aria-hidden="true"><%= _emoji %></span>
                                        </div>

                                        <!-- Pricing Info -->
                                        <% if (hasQuantitySystem) { %>
                                            <!-- New quantity-based system -->
                                            <div class="bg-emerald-50/70 border border-emerald-200 rounded-2xl p-4 mb-4">
                                                <div class="flex justify-between items-center mb-2">
                                                    <span class="text-gray-700 text-sm">Price per <%= product.unit.slice(0, -1)
                                                            %></span>
                                                    <span class="text-2xl font-extrabold text-gray-900">₹<%=
                                                            product.pricePerUnit.toFixed(2) %></span>
                                                </div>
                                                <div class="flex justify-between items-center text-sm">
                                                    <span class="text-gray-600">Available:</span>
                                                    <span
                                                        class="font-semibold <%= availableQty < product.totalQuantity * 0.2 ? 'text-red-600' : 'text-gray-900' %>">
                                                        <%= availableQty.toFixed(1) %> / <%= product.totalQuantity %>
                                                                <%= product.unit %>
                                                    </span>
                                                </div>
                                                <% if (product.minOrderQuantity && product.minOrderQuantity> 1) { %>
                                                    <div class="text-xs text-gray-600 mt-1">Min order: <%=
                                                            product.minOrderQuantity %>
                                                            <%= product.unit %>
                                                    </div>
                                                    <% } %>
                                            </div>
                                            <% } else { %>
                                                <!-- Old fixed-price system (backwards compatibility) -->
                                                <div class="bg-emerald-50/70 border border-emerald-200 rounded-2xl p-4 mb-4">
                                                    <div class="flex justify-between items-center">
                                                        <span class="text-gray-700 text-sm">Price</span>
                                                        <span class="text-2xl font-extrabold text-gray-900">₹<%= (product.price ||
                                                                0).toFixed(2) %></span>
                                                    </div>
                                                    <% if (product.quantity) { %>
                                                        <div class="text-sm text-gray-600 mt-1">Quantity: <%= product.quantity
                                                                %>
                                                                <%= product.unit %>
                                                        </div>
                                                        <% } %>
                                                </div>
                                                <% } %>
                                        <!-- Order Section (Buyers Only) -->
                                        <% if (user.role==='buyer' ) { %>
                                            <div class="mb-4 p-4 bg-slate-50 border border-slate-200 rounded-2xl">
                                                <label class="block text-sm font-medium text-gray-700 mb-2">Quantity
                                                    to
                                                    order:</label>
                                                <div class="flex items-center space-x-2">
                                                    <input type="number" id="qty-<%= product._id %>"
                                                        min="<%= product.minOrderQuantity %>"
                                                        max="<%= availableQty %>" step="0.1"
                                                        value="<%= product.minOrderQuantity %>"
                                                        class="input-field flex-1"
                                                        oninput="updateTotal('<%= product._id %>', <%= product.pricePerUnit %>, '<%= product.unit %>')">
                                                    <span class="text-gray-600">
                                                        <%= product.unit %>
                                                    </span>
                                                </div>
                                                <div class="mt-2 text-center">
                                                    <span class="text-sm text-gray-600">Total: </span>
                                                    <span id="total-<%= product._id %>"
                                                        class="text-lg font-bold text-emerald-600">
                                                        ₹<%= (product.minOrderQuantity *
                                                            product.pricePerUnit).toFixed(2) %>
                                                    </span>
                                                </div>
                                            </div>

                                            <!-- Delivery Address -->
                                            <div class="mb-4 p-4 bg-amber-50 border border-amber-200 rounded-2xl">
                                                <label class="block text-sm font-medium text-gray-700 mb-2">📍
                                                    Delivery Address *</label>
                                                <textarea id="address-<%= product._id %>" rows="3"
                                                    placeholder="Enter your complete delivery address..."
                                                    class="input-field w-full resize-none"
                                                    required></textarea>
                                                <p class="text-xs text-gray-600 mt-1">Estimated delivery: 5 business
                                                    days</p>
                                            </div>

                                            <!-- Payment Method -->
                                            <div class="mb-4 p-4 bg-emerald-50/60 border border-emerald-200 rounded-2xl">
                                                <label class="block text-sm font-medium text-gray-700 mb-2">💳
                                                    Payment Method</label>
                                                <select id="payment-<%= product._id %>"
                                                    class="input-field w-full">
                                                    <option value="Cash on Delivery">Cash on Delivery</option>
                                                    <option value="UPI">UPI</option>
                                                    <option value="Bank Transfer">Bank Transfer</option>
                                                    <option value="Card Payment">Card Payment</option>
                                                </select>
                                            </div>
                                            <% } %>

                                        <!-- Source Animal Info -->
                                        <% if (product.animal) { %>
                                            <div
                                                class="bg-green-50 border border-green-200 rounded-2xl p-3 mb-4">
                                                <div class="flex items-center gap-2 mb-1">
                                                    <span class="w-8 h-8 rounded-full bg-emerald-600 text-white text-xs font-bold flex items-center justify-center flex-shrink-0">
                                                        <%= product.animal.tagId.toString().slice(0, 2).toUpperCase() %>
                                                    </span>
                                                    <div>
                                                        <div class="text-xs text-gray-600">🐮 Source Animal</div>
                                                        <div class="font-semibold text-gray-900">
                                                            <%= product.animal.tagId %>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="text-sm text-gray-600">
                                                    <%= product.animal.species %>
                                                        <%= product.animal.breed ? '- ' +
                                                            product.animal.breed : '' %>
                                                </div>
                                                <div class="mt-2">
                                                    <div class="text-xs text-gray-600 mb-1">Health Score
                                                    </div>
                                                    <div class="flex items-center space-x-2">
                                                        <div class="flex-1 bg-gray-200 rounded-full h-2">
                                                            <div class="h-2 rounded-full bg-health-good"
                                                                style="width: <%= product.animal.healthScore %>%">
                                                            </div>
                                                        </div>
                                                        <span
                                                            class="text-sm font-semibold text-emerald-600">
                                                            <%= product.animal.healthScore %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            <% } %>

                                        <% if (product.description) { %>
                                            <p class="text-gray-600 text-sm mb-4">
                                                <%= product.description %>
                                            </p>
                                            <% } %>

                                        <!-- Actions -->
                                        <% if (user.role==='buyer' ) { %>
                                            <button
                                                onclick="placeOrder('<%= product._id %>')"
                                                class="btn-primary w-full">
                                                Order 🛒
                                            </button>
                                            <% } %>

                                        <div
                                            class="mt-3 text-xs text-gray-500 text-center">
                                            Listed <%= new
                                                Date(product.createdAt).toLocaleDateString('en-IN')
                                                %>
                                        </div>
                                    </div>
                                    <% }) %>
                        </div>
                        <% } %>
            </section>
        </div>
    </main>

    <footer class="bg-slate-950 mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 md:grid-cols-4 gap-8">
            <div>
                <p class="text-xl font-extrabold text-white">🐄 JeevBandhu</p>
                <p class="text-slate-400 text-sm mt-3">Bio-safe livestock health management for Indian farmers. Smart forecasting for healthy livestock. 🌱</p>
            </div>
            <div>
                <p class="label-caps text-emerald-400 mb-3">Platform</p>
                <ul class="space-y-2 text-sm text-slate-300">
                    <li><a href="/dashboard" class="hover:text-emerald-400 transition">Dashboard</a></li>
                    <li><a href="/marketplace" class="hover:text-emerald-400 transition">Marketplace</a></li>
                    <li><a href="/community" class="hover:text-emerald-400 transition">Community</a></li>
                </ul>
            </div>
            <div>
                <p class="label-caps text-emerald-400 mb-3">Resources</p>
                <ul class="space-y-2 text-sm text-slate-300">
                    <li><a href="/guide/medicine-guide" class="hover:text-emerald-400 transition">Medicine Guide</a></li>
                    <li><a href="/ai-assistant" class="hover:text-emerald-400 transition">AI Assistant</a></li>
                    <li><a href="/compliance" class="hover:text-emerald-400 transition">Biosecurity</a></li>
                </ul>
            </div>
            <div>
                <p class="label-caps text-emerald-400 mb-3">Trust</p>
                <p class="text-sm text-slate-300">Every product verified bio-safe with full withdrawal-period compliance.</p>
            </div>
        </div>
        <div class="border-t border-white/10">
            <p class="text-center text-slate-500 text-sm py-5">© 2024 JeevBandhu — Ensuring Bio-Safe Livestock Products</p>
        </div>
    </footer>

    <script>
        function updateTotal(productId, pricePerUnit, unit) {
            const qtyInput = document.getElementById(`qty-${productId}`);
            const totalSpan = document.getElementById(`total-${productId}`);
            const qty = parseFloat(qtyInput.value) || 0;
            const total = qty * pricePerUnit;
            totalSpan.textContent = `₹${total.toFixed(2)}`;
        }

        async function placeOrder(productId) {
            const qtyInput = document.getElementById(`qty-${productId}`);
            const quantity = parseFloat(qtyInput.value);
            const addressInput = document.getElementById(`address-${productId}`);
            const deliveryAddress = addressInput ? addressInput.value.trim() : '';
            const paymentSelect = document.getElementById(`payment-${productId}`);
            const paymentMethod = paymentSelect ? paymentSelect.value : 'Cash on Delivery';

            if (!quantity || quantity <= 0) {
                alert('❌ Please enter a valid quantity');
                return;
            }

            if (!deliveryAddress) {
                alert('❌ Please enter your delivery address');
                return;
            }

            if (!confirm(`Confirm order of ${quantity} units?\nDelivery to: ${deliveryAddress}\nPayment: ${paymentMethod}`)) {
                return;
            }

            try {
                const response = await fetch('/orders/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        productId,
                        quantity,
                        deliveryAddress,
                        paymentMethod
                    })
                });

                const result = await response.json();

                if (result.success) {
                    alert(`✅ Order placed successfully! Total: ₹${result.totalPrice.toFixed(2)}\nEstimated delivery: 5 business days`);
                    window.location.reload();
                } else {
                    alert(`❌ ${result.error}`);
                }
            } catch (error) {
                alert('❌ Failed to place order. Please try again.');
            }
        }

        // Search and Filter Functionality
        function filterProducts() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const maxPrice = parseFloat(document.getElementById('priceFilter').value) || Infinity;
            const minQuantity = parseFloat(document.getElementById('quantityFilter').value) || 0;

            const productCards = document.querySelectorAll('.product-card');
            let visibleCount = 0;

            productCards.forEach(card => {
                const productType = card.dataset.productType;
                const price = parseFloat(card.dataset.price);
                const quantity = parseFloat(card.dataset.quantity);

                const matchesSearch = productType.includes(searchTerm);
                const matchesPrice = price <= maxPrice;
                const matchesQuantity = quantity >= minQuantity;

                if (matchesSearch && matchesPrice && matchesQuantity) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // Update visible count
            document.getElementById('visibleCount').textContent = visibleCount;
        }

        function clearFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('priceFilter').value = '';
            document.getElementById('quantityFilter').value = '';
            filterProducts();
        }

        // Attach event listeners
        document.getElementById('searchInput')?.addEventListener('input', filterProducts);
        document.getElementById('priceFilter')?.addEventListener('input', filterProducts);
        document.getElementById('quantityFilter')?.addEventListener('input', filterProducts);

        // Mobile menu toggle
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        if (mobileMenuBtn && mobileMenu) {
            mobileMenuBtn.addEventListener('click', (e) => { e.stopPropagation(); mobileMenu.classList.toggle('hidden'); mobileMenu.classList.toggle('active'); mobileMenuBtn.classList.toggle('active'); });
            document.addEventListener('click', (e) => { if (!mobileMenu.contains(e.target) && !mobileMenuBtn.contains(e.target)) { mobileMenu.classList.add('hidden'); mobileMenu.classList.remove('active'); mobileMenuBtn.classList.remove('active'); } });
        }

        // Mobile filter panel toggle
        const filterToggleBtn = document.getElementById('filterToggleBtn');
        const filterPanel = document.getElementById('filterPanel');
        const filterToggleChevron = document.getElementById('filterToggleChevron');
        if (filterToggleBtn && filterPanel) {
            filterToggleBtn.addEventListener('click', () => {
                const isHidden = filterPanel.classList.toggle('hidden');
                filterToggleBtn.setAttribute('aria-expanded', String(!isHidden));
                if (filterToggleChevron) filterToggleChevron.classList.toggle('rotate-180', !isHidden);
            });
        }

        // Scroll reveal
        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); revealObserver.unobserve(e.target); } });
        }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
    </script>
</body>

</html>
